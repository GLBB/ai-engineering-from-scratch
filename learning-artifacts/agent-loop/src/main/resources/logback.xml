<configuration>
    <property name="LOG_DIR" value="${AGENT_LOG_DIR:-logs}"/>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/agent.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/agent.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>1MB</maxFileSize>
            <maxHistory>5</maxHistory>
            <totalSizeCap>5MB</totalSizeCap>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level %logger [requestId=%X{requestId} traceId=%X{traceId}] - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="dev.learning.agent" level="DEBUG"/>
    <root level="WARN">
        <appender-ref ref="FILE"/>
    </root>
</configuration>
